{
  "name": "content-migrator",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npm-watch",
    "job": "npm-run-all mkindexdir index sync",
    "index": "node index-content.js",
    "mkindexdir": "mkdirp ../apps/cns-website/src/assets/indexes",
    "migrate-old-data": "node src/convert-data.js",
    "sync": "rsync -avz --delete ../content ../apps/cns-website/src/assets",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "watch": {
    "index": {
      "patterns": [
        "../content"
      ],
      "extensions": "md",
      "quiet": false
    },
    "sync": {
      "patterns": [
        "../content"
      ],
      "extensions": "md",
      "quiet": false
    }
  },
  "dependencies": {
    "commander": "^14.0.2",
    "duckdb": "^1.4.1",
    "glob": "^11.0.3",
    "html-entities": "^2.6.0",
    "js-yaml": "^4.1.0",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "npm-watch": "^0.13.0",
    "papaparse": "^5.5.3",
    "slugify": "^1.6.6",
    "turndown": "^7.2.2"
  }
}
